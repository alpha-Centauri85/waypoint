PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session cookies. Generate a long random value in
# production, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional overrides:
# DATA_DIR=./data          # where the SQLite file(s) live
# DB_PATH=./data/waypoint.db

# Auth rate limiting (login/register). Defaults: 20 attempts / 15 minutes per IP.
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_MAX=20

# --- Production / single-origin deploy ---
# With NODE_ENV=production, Express serves the built client (client/dist) and
# no CORS is needed. Run `npm run build` first, then `npm start`.
# SERVE_CLIENT=true          # force serving the client outside production
# CLIENT_DIST=./client/dist  # override the built-client location
# secure cookies need HTTPS. Set false to trial production over plain HTTP:
# SECURE_COOKIES=false
# Behind a TLS-terminating reverse proxy (Caddy/IIS/nginx), trust it so secure
# cookies + real client IPs work:
# TRUST_PROXY=1
